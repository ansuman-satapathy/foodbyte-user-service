# Copy this to .env for local development outside Docker.
# When running inside Docker Compose, these are set in docker-compose.yml.
# NEVER commit a real .env file to git.

DATABASE_URL=postgresql://users_app:users_secret@localhost:5432/users_db
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEBUG=false
